APP_NAME="FastAPI API"
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=mysql+pymysql://fastapi:fastapi@127.0.0.1:3306/fastapi_db?charset=utf8mb4
# Redis: rate limiting y revocación de refresh tokens (fail-open si no responde)
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_EMAIL_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
